[Unit]
Description=Durable Pi hub (web UI and device registry, user)
After=network.target

[Service]
Type=simple
WorkingDirectory=__APP__
ExecStart=__NODE__ __APP__/node_modules/tsx/dist/cli.mjs apps/dpi-playground-hub/src/main.ts
Environment=PATH=__PATH__
Environment=HOME=__HOME__
Environment=DPI_HOME=__DPI_HOME__
Environment=DPI_HUB_PORT=__PORT__
Environment=NODE_NO_WARNINGS=1
Restart=always
RestartSec=2
KillSignal=SIGTERM
TimeoutStopSec=20
StandardOutput=append:__LOG__
StandardError=append:__LOG__

[Install]
WantedBy=default.target
